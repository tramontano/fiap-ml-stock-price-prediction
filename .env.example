# ==========================================
# INFRAESTRUTURA
# ==========================================
ENVIRONMENT=local

# API
API_HOST=0.0.0.0
API_PORT=8001
API_V1_STR=/api/v1
WEB_CONCURRENCY=1
API_BASE_URL=http://model:${API_PORT}
API_USERNAME=API_USERNAME
API_PASSWORD=YOUR_PASSWORD

# MinIO (Simulador de S3 da AWS)
MINIO_ROOT_USER=ADMIN_USERNAME
MINIO_ROOT_PASSWORD=YOUR_PASSWORD
S3_ENDPOINT_URL=http://127.0.0.1:9000

# PostgreSQL (Para futuro uso do Airflow)
POSTGRES_USER=ADMIN_USERNAME
POSTGRES_PASSWORD=YOUR_PASSWORD
POSTGRES_DB=airflow_db
OPTUNA_STORAGE_URI=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Grafana
GF_SECURITY_ADMIN_USER=ADMIN_USERNAME
GF_SECURITY_ADMIN_PASSWORD=YOUR_PASSWORD
GF_AUTH_ANONYMOUS_ENABLED=true

# ==========================================
# INTEGRAÇÕES EXTERNAS (MLOps)
# ==========================================

# DagsHub / MLflow Tracking
MLFLOW_TRACKING_URI=https://dagshub.com/YOUR_USERNAME/YOUR_REPOSITORY.mlflow
MLFLOW_TRACKING_USERNAME=YOUR_USERNAME
MLFLOW_TRACKING_PASSWORD=YOUR_PASSWORD
MLFLOW_EXPERIMENT_NAME=DAGSHUB_EXPERIMENT_NAME
DAGSHUB_REPO_NAME=DAGSHUB_REPO_NAME
DAGSHUB_APP_TOKEN=SECRET_TOKEN
MODEL_STAGE=champion # or challenger

# ==========================================
# ORQUESTRAÇÃO (Apache Airflow)
# ==========================================
AIRFLOW_API_URL=http://localhost:8080
AIRFLOW_USERNAME=YOUR_USERNAME
AIRFLOW_PASSWORD=YOUR_PASSWORD
AIRFLOW_UID=5000
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
AIRFLOW__CORE__AUTH_MANAGER=airflow.providers.fab.auth_manager.fab_auth_manager.FabAuthManager
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__SCHEDULER__ENABLE_HEALTH_CHECK=true
AIRFLOW__CORE__EXECUTION_API_SERVER_URL=http://${AIRFLOW_API_URL}/execution
AIRFLOW_CONFIG=/opt/airflow/config/airflow.cfg
